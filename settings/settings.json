{
  // ── Claude Code ──────────────────────────────────────────────
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "opus",

  // ── Look ─────────────────────────────────────────────────────
  "workbench.colorTheme": "Min Dark",
  "workbench.iconTheme": "symbols",

  // ── Writing, not coding ──────────────────────────────────────
  // Autocomplete popups are useful in code and maddening in prose.
  // Off for markdown and YAML, left on everywhere else.
  "[markdown]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.wordBasedSuggestions": "off"
  },
  "[yaml]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.wordBasedSuggestions": "off"
  },
  "cSpell.enableFiletypes": ["!markdown", "!yaml"],
  "yaml.validate": false,
  "editor.unicodeHighlight.nonBasicASCII": false,

  // Long paragraphs wrap to the window instead of running off the edge.
  "editor.wordWrap": "on",

  // SlashMD opens .md files as a Notion-style editor.
  // This line is not optional. Office Viewer also claims .md, so without an
  // explicit association the two fight and you get whichever loads first.
  "workbench.editorAssociations": {
    "*.md": "slashmd.editor",
    "*.markdown": "slashmd.editor"
  },

  // ── Quiet the editor ─────────────────────────────────────────
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.lightbulb.enabled": "off",
  "breadcrumbs.enabled": false,
  "workbench.startupEditor": "none",
  "extensions.ignoreRecommendations": true,

  // ── Reading comfort ──────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.lineHeight": 1.7,
  "editor.padding.top": 16,

  // ── Behaviour ────────────────────────────────────────────────
  // Files open as real tabs instead of italic previews that replace each other.
  "workbench.editor.enablePreview": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "chat.viewSessions.orientation": "stacked",
  "editor.accessibilitySupport": "off",
  "http.systemCertificatesNode": true
}
