  "name": "Navid VS Code",
  "icon": "rocket",
  "settings": "{\"settings\": \"{\\n  // \\u2500\\u2500 Claude Code \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"claudeCode.selectedModel\\\": \\\"opus\\\",\\n\\n  // \\u2500\\u2500 Look \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  \\\"workbench.colorTheme\\\": \\\"Min Dark\\\",\\n  \\\"workbench.iconTheme\\\": \\\"symbols\\\",\\n\\n  // \\u2500\\u2500 Writing, not coding \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  // Autocomplete popups are useful in code and maddening in prose.\\n  // Off for markdown and YAML, left on everywhere else.\\n  \\\"[markdown]\\\": {\\n    \\\"editor.quickSuggestions\\\": {\\n      \\\"comments\\\": \\\"off\\\",\\n      \\\"strings\\\": \\\"off\\\",\\n      \\\"other\\\": \\\"off\\\"\\n    },\\n    \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n  },\\n  \\\"[yaml]\\\": {\\n    \\\"editor.quickSuggestions\\\": {\\n      \\\"comments\\\": \\\"off\\\",\\n      \\\"strings\\\": \\\"off\\\",\\n      \\\"other\\\": \\\"off\\\"\\n    },\\n    \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n  },\\n  \\\"cSpell.enableFiletypes\\\": [\\\"!markdown\\\", \\\"!yaml\\\"],\\n  \\\"yaml.validate\\\": false,\\n  \\\"editor.unicodeHighlight.nonBasicASCII\\\": false,\\n\\n  // Long paragraphs wrap to the window instead of running off the edge.\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n\\n  // SlashMD opens .md files as a Notion-style editor.\\n  // This line is not optional. Office Viewer also claims .md, so without an\\n  // explicit association the two fight and you get whichever loads first.\\n  \\\"workbench.editorAssociations\\\": {\\n    \\\"*.md\\\": \\\"slashmd.editor\\\",\\n    \\\"*.markdown\\\": \\\"slashmd.editor\\\"\\n  },\\n\\n  // \\u2500\\u2500 Quiet the editor \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"editor.stickyScroll.enabled\\\": false,\\n  \\\"editor.lightbulb.enabled\\\": \\\"off\\\",\\n  \\\"breadcrumbs.enabled\\\": false,\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"extensions.ignoreRecommendations\\\": true,\\n\\n  // \\u2500\\u2500 Reading comfort \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.lineHeight\\\": 1.7,\\n  \\\"editor.padding.top\\\": 16,\\n\\n  // \\u2500\\u2500 Behaviour \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n  // Files open as real tabs instead of italic previews that replace each other.\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n  \\\"files.autoSaveDelay\\\": 1000,\\n  \\\"diffEditor.useInlineViewWhenSpaceIsLimited\\\": false,\\n  \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n  \\\"http.systemCertificatesNode\\\": true\\n}\\n\"}",
